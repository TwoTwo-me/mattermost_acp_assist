# Mattermost server URL and team URL slug, not the team's display name.
MM_URL=https://mattermost.example.com
MM_TEAM=your-team

# Comma-separated IDs of channels your account can read.
MM_MONITOR_CHANNEL_IDS=your-channel-id

# Both values must belong to the same Mattermost account.
MM_OWNER1_TOKEN=your-personal-access-token
MM_OWNER1_USER_ID=your-mattermost-user-id

# Emoji names without surrounding colons. This setting is required.
TRIGGER_EMOJI=robot,robot_face
ACP_RESPONSE_LANGUAGE=Korean

# Optional UTF-8 prompt template, relative to the configuration home. Restart to reload.
# ACP_PROMPT_FILE=acp/prompt.txt

# Optional trusted Claude API endpoint. Explicit agents.json env takes precedence.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional model and effort overrides. Supported effort levels: low, medium, high, max.
# ACP_CLAUDE_MODEL=haiku
# ACP_CLAUDE_EFFORT=medium

# Opt in only in a trusted workspace. Skips Claude permission checks.
# ACP_CLAUDE_MODE=bypassPermissions

# Advanced inner Claude CLI options. Values must be strings or null.
# ACP_CLAUDE_EXTRA_ARGS={"max-turns":"5","verbose":null}
